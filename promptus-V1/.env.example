# Copier en .env.local pour le développement local.

# Postgres (docker compose up -d expose la base sur le port 5433)
DATABASE_URL=postgresql://promptus:promptus_dev@localhost:5433/promptus

# Génération d'images (optionnel). Fournisseur actuel : huggingface.
IMAGE_PROVIDER=huggingface
HUGGINGFACE_TOKEN=

# Génération par IA (OpenRouter). Sans clé, la page « Générer avec l'IA » explique quoi faire.
OPENROUTER_API_KEY=
# Modèle par défaut (modifiable par campagne dans Paramètres).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# URL publique de l'application, transmise à OpenRouter (facultatif).
APP_URL=http://localhost:3000

# Temps réel (WebSocket, `pnpm realtime`). Sans REALTIME_PUBLIC_URL, les
# navigateurs se connectent à ws://<hôte de la page>:3001.
REALTIME_PORT=3001
REALTIME_PUBLIC_URL=
