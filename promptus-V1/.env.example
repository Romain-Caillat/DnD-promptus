# Copier en .env.local pour le développement local.

# Postgres (docker compose up -d expose la base sur le port 5433)
DATABASE_URL=postgresql://promptus:promptus_dev@localhost:5433/promptus

# Images : OpenRouter si OPENROUTER_API_KEY est défini, sinon HuggingFace
# (HUGGINGFACE_TOKEN). IMAGE_PROVIDER=openrouter|huggingface force le choix.
IMAGE_PROVIDER=
HUGGINGFACE_TOKEN=

# Génération par IA (OpenRouter). Sans clé, la page « Générer avec l'IA » explique quoi faire.
OPENROUTER_API_KEY=
# Modèle par défaut (modifiable par campagne dans Paramètres).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Modèles d'images et de vidéos par défaut (modifiables par campagne).
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_VIDEO_MODEL=
# Dossier des médias générés (servis par /api/media).
MEDIA_DIR=./data/media
# URL publique de l'application, transmise à OpenRouter (facultatif).
APP_URL=http://localhost:3000

# Temps réel (WebSocket, `pnpm realtime`). Sans REALTIME_PUBLIC_URL, les
# navigateurs se connectent à ws://<hôte de la page>:3001.
REALTIME_PORT=3001
REALTIME_PUBLIC_URL=
