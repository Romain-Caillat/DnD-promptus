# Replace `promptus.example.com` with your actual domain.
# Caddy will automatically obtain and renew an HTTPS certificate.
# For local-only or LAN deployment, replace the domain with `:80`.

promptus.example.com {
  # Temps réel (WebSocket) : REALTIME_PUBLIC_URL=wss://promptus.example.com/realtime
  handle /realtime* {
    reverse_proxy realtime:3001
  }
  handle {
    reverse_proxy app:3000
    encode gzip
  }
}
