{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promptus",
  "version": "0.1.0",
  "identifier": "app.promptus.client",
  "build": {
    "frontendDist": "../front/dist",
    "devUrl": "http://localhost:4334",
    "beforeDevCommand": "cd front && bun run dev",
    "beforeBuildCommand": "cd front && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Promptus",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
