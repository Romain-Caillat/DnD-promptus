# Production settings, read by docker-compose.prod.yml through the
# deploy/ scripts. Copy to `.env.production` (gitignored) or let
# deploy/install.sh write it with fresh secrets. See docs/install.md.

# Public name players type, without https://. TLS is terminated by the
# reverse proxy in front (PCT 100's Traefik on Romain's server).
PROMPTUS_DOMAIN=promptus.example.org

# GMs sign in with a code sent to their email; anyone may create a GM
# account, and each GM only ever sees their own campaigns. Without
# SMTP_HOST the codes are written to the app's log instead:
#   docker compose -f docker-compose.prod.yml --env-file .env.production logs app | grep "sign-in code"
# Port 587 uses STARTTLS, 465 TLS from the start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database password, generated: openssl rand -hex 24
POSTGRES_PASSWORD=

# Where the app's HTTP port is published on this machine. Loopback by
# default; the LAN address when the reverse proxy runs elsewhere.
PROMPTUS_BIND=127.0.0.1
PROMPTUS_PORT=4380

# Folder deploy/backup.sh writes its archives to. Put it on another
# disk than the database (docs/backup.md).
PROMPTUS_BACKUP_DIR=./backups
# Archives kept by deploy/backup.sh; older ones are deleted.
PROMPTUS_BACKUP_KEEP=30
# Optional: an age public key (age1…). When set, every archive is
# encrypted to it and only its private key, kept off this machine, can
# restore it. Needs `age` installed on this machine.
PROMPTUS_BACKUP_AGE_RECIPIENT=

# Origins of the desktop and phone shells allowed to call the API.
# PROMPTUS_APP_ORIGINS=tauri://localhost,http://tauri.localhost

# AI (ai/route-llm-provider): the OpenRouter key. Without it every AI
# feature answers "not configured". Each campaign's budget caps what
# its calls may spend.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_VIDEO_MODEL=google/veo-3.1
# What a call is estimated at before it leaves, in dollars (the budget
# check refuses on the estimate; the real cost is recorded after).
# AI_PRICE_INPUT_PER_MTOK=3
# AI_PRICE_OUTPUT_PER_MTOK=15
# AI_PRICE_PER_IMAGE=0.04
# AI_PRICE_PER_VIDEO=4

RUST_LOG=info
