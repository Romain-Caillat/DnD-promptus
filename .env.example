# Copy to `.env` and adjust. `.env` is gitignored.

# Dev database (docker-compose.dev.yml, `bun run db:start`).
DATABASE_URL=postgres://promptus:promptus_dev@localhost:5432/promptus
POSTGRES_PASSWORD=promptus_dev

# Integration tests use their own database in the same container, created
# on first start of the volume. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgres://promptus:promptus_dev@localhost:5432/promptus_test

# Axum server. The Vite dev server runs on 4334 and proxies /api here.
PORT=4333
ALLOWED_ORIGINS=http://localhost:4334,http://127.0.0.1:4334,tauri://localhost
# Built front served by Axum next to /api. Unset in development (Vite
# serves it); the production image sets /srv/front. Try a production-like
# run locally with `bun run build:front` and FRONT_DIR=front/dist.
# FRONT_DIR=

# GM sign-in (platform/sign-in-gm).
# The origin people open the app at. The session cookie is marked
# Secure when it is https. In dev, the Vite server.
PUBLIC_ORIGIN=http://localhost:4334
# A GM signs in with a code emailed to them. Unset SMTP_HOST (dev), the
# code is written to the server log instead. Port 587 uses STARTTLS,
# 465 TLS from the start; SMTP_FROM is required with SMTP_HOST.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Promptus <noreply@example.org>

# AI (ai/route-llm-provider). Without a key every AI feature answers
# "not configured". AI_PROVIDER=fake runs the deterministic provider
# (keyless development; its videos are not playable, and it hears no
# voice: a dictation reads as one fixed sentence).
# AI_PROVIDER=fake
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_VIDEO_MODEL=google/veo-3.1
# The model that writes down what the GM dictates (it must accept audio).
# OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash
# What a call is estimated at before it leaves, in dollars (the budget
# check refuses on the estimate; the real cost is recorded after).
# AI_PRICE_INPUT_PER_MTOK=3
# AI_PRICE_OUTPUT_PER_MTOK=15
# AI_PRICE_PER_IMAGE=0.04
# AI_PRICE_PER_VIDEO=4
# AI_PRICE_PER_AUDIO_MINUTE=0.01

RUST_LOG=info
