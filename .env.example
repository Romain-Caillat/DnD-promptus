# Copy to `.env` and adjust. `.env` is gitignored.

# Dev database (docker-compose.dev.yml, `bun run db:start`).
DATABASE_URL=postgres://promptus:promptus_dev@localhost:5432/promptus
POSTGRES_PASSWORD=promptus_dev

# Integration tests use their own database in the same container, created
# on first start of the volume. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgres://promptus:promptus_dev@localhost:5432/promptus_test

# Axum server. The Vite dev server runs on 4334 and proxies /api here.
PORT=4333
ALLOWED_ORIGINS=http://localhost:4334,http://127.0.0.1:4334,tauri://localhost
# Built front served by Axum next to /api. Unset in development (Vite
# serves it); the production image sets /srv/front. Try a production-like
# run locally with `bun run build:front` and FRONT_DIR=front/dist.
# FRONT_DIR=

RUST_LOG=info
